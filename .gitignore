# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 삭제 대기 파일 (바로 지우지 않고 여기로 옮겨둠)
/trash-can/*
!/trash-can/.gitkeep

# python (export_OA 수집기)
.venv/
__pycache__/
*.pyc

certificates

# 사내 인사·자산 데이터 내보내기 파일(대외비) — 저장소에 올리지 않는다
export_m365/*.csv
export_OA/*.csv
*.xlsx


.vercel
.env*

# 임시 배포 스크립트(커밋하지 않음)
scripts/tmp-*.sh

# 개발 도구 내부 상태(저장소에 남길 필요 없음)
/.bkit/
/supabase/.temp/
